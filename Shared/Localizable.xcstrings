        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 직사각형의 왼쪽과 오른쪽에 서로 다른 항목을 표시합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra dos cosas distintas lado a lado en el rectángulo grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche deux éléments différents côte à côte dans le grand rectangle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt zwei verschiedene Dinge nebeneinander im großen Rechteck."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra due cose diverse affiancate nel rettangolo grande."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra duas coisas diferentes lado a lado no retângulo grande."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает две разные вещи рядом в большом прямоугольнике."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض شيئين مختلفين جنبًا إلى جنب في المستطيل الكبير."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont twee verschillende dingen naast elkaar in de grote rechthoek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar två olika saker sida vid sida i den stora rektangeln."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük dikdörtgende iki farklı şeyi yan yana gösterir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan dua hal berbeda berdampingan di persegi panjang besar."
          }
        }
      }
    },
