    "1. Apple Watch の文字盤を長押しして「編集」": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Apple Watch の文字盤を長押しして「編集」"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Touch and hold the watch face, then tap Edit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 按住 Apple Watch 表盘，然后轻点“编辑”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 按住 Apple Watch 錶面，然後點一下「編輯」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Apple Watch 페이스를 길게 누른 다음 '편집'을 탭"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Mantén pulsada la esfera y toca Editar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Maintenez le doigt sur le cadran, puis touchez Modifier"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Zifferblatt gedrückt halten und „Bearbeiten“ tippen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Tieni premuto il quadrante e tocca Modifica"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Toque e segure o mostrador e toque em Editar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Нажмите и удерживайте циферблат, затем «Изменить»"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "1. المس واجهة الساعة مطولًا ثم اضغط تعديل"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Houd de wijzerplaat ingedrukt en tik op Wijzig"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Håll ned fingret på urtavlan och tryck på Redigera"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Saat kadranına basılı tutun, sonra Düzenle'ye dokunun"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Sentuh lama tampilan jam, lalu ketuk Edit"
          }
        }
      }
    },
    "2. 大きい四角を押し、このアプリを選ぶ": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 大きい四角を押し、このアプリを選ぶ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Tap the large rectangle and choose Duo Slot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 轻点大矩形，选择 Duo Slot"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 點一下大型矩形，選擇 Duo Slot"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 큰 직사각형을 탭하고 Duo Slot 선택"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Toca el rectángulo grande y elige Duo Slot"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Touchez le grand rectangle et choisissez Duo Slot"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Tippe auf das große Rechteck und wähle Duo Slot"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Tocca il rettangolo grande e scegli Duo Slot"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Toque no retângulo grande e escolha Duo Slot"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Коснитесь большого прямоугольника и выберите Duo Slot"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "2. اضغط على المستطيل الكبير واختر Duo Slot"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Tik op de grote rechthoek en kies Duo Slot"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Tryck på den stora rektangeln och välj Duo Slot"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Büyük dikdörtgene dokunup Duo Slot'u seçin"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Ketuk persegi panjang besar dan pilih Duo Slot"
          }
        }
      }
    },
    "3. 左右の組み合わせ（例：歩数｜電池）を選ぶ": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 左右の組み合わせ（例：歩数｜電池）を選ぶ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Pick a pair (e.g. Steps | Battery)"
          }
        },
