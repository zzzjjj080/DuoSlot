          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Choisissez une paire (ex. Pas | Batterie)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Wähle ein Paar (z. B. Schritte | Batterie)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Scegli una coppia (es. Passi | Batteria)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Escolha um par (ex.: Passos | Bateria)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Выберите пару (например, Шаги | Батарея)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "3. اختر زوجًا (مثل: الخطوات | البطارية)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Kies een paar (bijv. Stappen | Batterij)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Välj ett par (t.ex. Steg | Batteri)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Bir çift seçin (örn. Adım | Pil)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Pilih pasangan (mis. Langkah | Baterai)"
          }
        }
      }
    },
    "文字盤で左右を押すと、押した側の画面が Watch で開きます。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字盤で左右を押すと、押した側の画面が Watch で開きます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap either side on the watch face to open it on your Apple Watch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在表盘上轻点任意一侧，即可在 Apple Watch 上打开该内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在錶面上點一下任一側，即可在 Apple Watch 上打開該內容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치 페이스에서 한쪽을 누르면 Apple Watch에서 해당 화면이 열립니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un lado en la esfera para abrirlo en el Apple Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un côté du cadran pour l’ouvrir sur l’Apple Watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf dem Zifferblatt auf eine Seite, um sie auf der Apple Watch zu öffnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un lato sul quadrante per aprirlo su Apple Watch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um lado no mostrador para abri-lo no Apple Watch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь стороны на циферблате, чтобы открыть её на Apple Watch."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على أي جانب في واجهة الساعة لفتحه على Apple Watch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een kant van de wijzerplaat om die op je Apple Watch te openen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en sida på urtavlan för att öppna den på Apple Watch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch'ta açmak için kadranda bir tarafa dokunun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk salah satu sisi di tampilan jam untuk membukanya di Apple Watch."
          }
        }
      }
    },
