          "stringUnit": {
            "state": "translated",
            "value": "3. 选择组合（例如：步数｜电池）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 選擇組合（例如：步數｜電池）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 조합 선택(예: 걸음 수｜배터리)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
